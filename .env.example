# Copy to .env and fill in. .env is gitignored. chmod 600 .env before use.

# HuggingFace token — required for pyannote community-1 (gated).
# Accept the model card at https://hf.co/pyannote/speaker-diarization-community-1
# before the token can pull the weights.
HF_TOKEN=

# Optional: force a compute device. Leave blank for auto (cuda if available,
# else cpu). Set to "cpu" to force CPU even when a GPU is present.
DUBBING_DEVICE=

# Optional: the speaker-gender classifier, as a HuggingFace repo id. Blank
# uses `alefiury/wav2vec2-large-xlsr-53-gender-recognition-librispeech`.
# The label map is read off the checkpoint's own `config.id2label` (this one
# is {0: female, 1: male}), and a checkpoint whose labels are not male/female
# is refused at load rather than guessed at — the prediction is a HARD FILTER
# on the voice catalog, so an inverted map miscasts every speaker at once.
DUBBING_GENDER_MODEL=

# -------------------------------------------------------------------------
# ASD — TalkNet / TS-TalkNet. Neither is pip-installable; clone the repo
# and point these at the clone + a checkpoint from the upstream README.
# -------------------------------------------------------------------------
TALKNET_REPO=third_party/TalkNet-ASD
TALKNET_CHECKPOINT=third_party/TalkNet-ASD/pretrain_TalkSet.model
TS_TALKNET_REPO=third_party/TS-TalkNet
TS_TALKNET_CHECKPOINT=third_party/TS-TalkNet/pretrain_AVA_CVPR.model
TS_TALKNET_SPEAKER_ENCODER=third_party/TS-TalkNet/pretrain_SpeakerEncoder.model

# -------------------------------------------------------------------------
# Bodhan AI — ASR / MT / TTS. One endpoint + key per service, per plan §5.
# -------------------------------------------------------------------------
BODHAN_ASR_URL=https://api.bodhan.ai/v1
BODHAN_ASR_KEY=
BODHAN_ASR_MODEL=indic-transcribe-core

BODHAN_MT_URL=https://api.bodhan.ai/v1
BODHAN_MT_KEY=
BODHAN_MT_MODEL=indic-translate

BODHAN_TTS_URL=https://api.bodhan.ai/v1
BODHAN_TTS_KEY=
BODHAN_TTS_MODEL=indic-speak
# Where the speaking rate goes in the /v1/audio/speech payload, and the
# bounds it is clamped to. The published API docs do not list a rate field;
# `speed` follows the OpenAI audio shape this endpoint otherwise matches.
# A 422 on a rated request means this name is wrong — try `rate`, or
# `instructions.speed` to nest it inside the instructions blob. Only sent
# when a rate other than 1.0 is asked for, so leaving these alone keeps the
# payload exactly as it was.
BODHAN_TTS_RATE_FIELD=speed
BODHAN_TTS_RATE_RANGE=0.25,4.0

BODHAN_TRANSLIT_URL=https://api.bodhan.ai/v1
BODHAN_TRANSLIT_KEY=
BODHAN_TRANSLIT_MODEL=indic-transliterate

# -------------------------------------------------------------------------
# OpenRouter — OpenAI-compatible gateway to many hosted LLMs. Read by
# `backend/llm.py`, which `backend/edit_agent.py` uses to turn a plain-English
# edit request into pipeline operations and to rewrite translated lines
# (retranslate / set_tone / code_mix mode=llm). Still unused by the plan's
# "LLM with termbase" code-mix path and by LLM-judge evaluation.
#
# The key is named OPENROUTER_API_KEY rather than ..._KEY (the Bodhan
# pattern) because that is the name OpenRouter's own docs and every
# OpenAI-SDK snippet use — worth the small inconsistency.
#
# OPENROUTER_MODEL takes a full `vendor/model` slug; browse them at
# https://openrouter.ai/models. Keys are issued at
# https://openrouter.ai/keys and are prefixed `sk-or-v1-`.
#
# Leaving it blank gives `google/gemma-3-12b-it` (changed 2026-10-19 from
# the 4B). There is no "gemma-3b" slug on OpenRouter; the family is
# google/gemma-3-{1b,4b,12b,27b}-it, each also available as `:free`.
# A 4B model is a weak structured-output generator, which is why the edit
# agent validates every op it returns and falls back to a regex parser —
# move to 12b/27b if the readings come back wrong too often.
#
# Leaving the whole block blank breaks nothing: the edit agent runs on its
# regex parser, and only the text-rewriting ops refuse.
# -------------------------------------------------------------------------
OPENROUTER_API_KEY=

# -------------------------------------------------------------------------
# Langfuse — LLM tracing, token usage, cost and latency. Added 2026-10-19.
#
# OPTIONAL: leave blank and tracing is a no-op, exactly as a blank
# OPENROUTER_API_KEY is. Nothing warns on the hot path when both are unset.
#
# BOTH KEYS ARE REQUIRED. Langfuse authenticates with HTTP Basic where the
# PUBLIC key is the username and the SECRET key is the password — for the
# SDK and the REST API alike. A secret key on its own can neither send
# traces nor read usage back.
#
# The public key is NOT a secret. Langfuse → Project Settings → API Keys
# shows the pk-lf-… any time you look; only the sk-lf-… is displayed once
# and unrecoverable. So "I only have the private key" is fixed by copying
# the public one out of that page.
#
# `$PY -m backend.edit_agent --check-langfuse` verifies the pair and the
# host in one round trip and prints no secrets.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Blank = https://cloud.langfuse.com. Point it at your own instance to keep
# the traced text on this host: LANGFUSE_HOST=http://localhost:3000
LANGFUSE_HOST=

# 0 sends timings, token counts, costs and model parameters but NOT prompt
# or completion text. The prompts carry the cue table — the dub's actual
# dialogue — so this is the switch to use when the material is not yours to
# send to a hosted service. Default (blank/1) captures everything.
DUBBING_LANGFUSE_CAPTURE_CONTENT=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# JSON mode: auto (default, = OFF) | on | off.
#
# OFF is a measurement, not a preference. On 2026-10-19 gemma-3-12b-it with
# `response_format={"type":"json_object"}` answered the edit-agent prompt with
#     {"ops":[{}]}
#     {".ops":[{".op":".lipsync_window", ...
# — an empty op, and keys prefixed with a full stop. Both are VALID JSON, so
# nothing downstream can tell they are wrong. The same requests with json mode
# off came back correct in ```json fences, which `extract_json` already strips.
# Set `on` only for a model that genuinely needs the constraint.
OPENROUTER_JSON_MODE=

# Optional transport knobs for backend/llm.py. Defaults in brackets.
OPENROUTER_MAX_RETRIES=          # [4] retries on 429/5xx, exponential backoff
OPENROUTER_MIN_INTERVAL_S=       # [0] floor between requests, as Bodhan uses

# -------------------------------------------------------------------------
# Voice conversion. Both OpenVoice v2 and Vevo are run from a local
# clone; neither ships on PyPI. Vevo weights are CC-BY-NC — do not use
# in deployed builds without re-checking the licence.
# -------------------------------------------------------------------------
OPENVOICE_REPO=third_party/OpenVoice
OPENVOICE_CHECKPOINTS=third_party/OpenVoice/checkpoints_v2
AMPHION_REPO=third_party/Amphion
VEVO_CHECKPOINTS=third_party/Amphion/pretrained/Vevo

# -------------------------------------------------------------------------
# Lip-sync. Four adapters; each wraps an external repo. Weights for the
# Rudrabha-group models (LipGAN, Wav2Lip) are non-commercial-use only.
# LipGAN runs through a PyTorch port (inference_torch.py) that loads the
# original Keras .h5 directly — no TF 1.x env required. Blackwell-safe.
# -------------------------------------------------------------------------
LIPGAN_REPO=third_party/LipGAN
LIPGAN_CHECKPOINT=third_party/LipGAN/logs/lipgan_residual_mel.h5
LIPGAN_PYTHON=
WAV2LIP_REPO=third_party/Wav2Lip
WAV2LIP_CHECKPOINT=third_party/Wav2Lip/checkpoints/wav2lip_gan.pth
WAV2LIP_PYTHON=

# Wav2Lip-HD (saifhassan/Wav2Lip-HD): the Wav2Lip render above, then a
# Real-ESRGAN x4plus + GFPGAN pass over every frame. Stage 2 only -- stage 1
# reuses WAV2LIP_* above, so this model always tracks the wav2lip defaults.
# Its own env exists because basicsr imports
# torchvision.transforms.functional_tensor (gone in torchvision >= 0.17) while
# `dubbing` is on 0.23, and these sm_120 cards rule out pinning torch back.
# Blank is safe: resolve_env_python() falls back to the sibling conda env.
WAV2LIPHD_REPO=third_party/Wav2Lip-HD
WAV2LIPHD_WEIGHTS=models/weights/wav2lip_hd
WAV2LIPHD_PYTHON=

# MuseTalk and LatentSync each need their OWN interpreter, and leaving the
# PYTHON var blank is NOT the harmless default it is for LipGAN/Wav2Lip.
# Those two run in the `dubbing` env; these two cannot -- their upstream pins
# are incompatible, which is why the separate conda envs exist at all.
# `<MODEL>_PYTHON` empty falls back to `sys.executable`, i.e. the `dubbing`
# env, where `import diffusers` fails and the adapter dies AFTER the pipeline
# has paid for ASR, MT, TTS and the mix. Measured 2026-10-17: a 40 s clip ran
# all 15 stages, logged `lipsync[musetalk]: done ->` with `err=... rc=1` in a
# parenthetical, exited 0, and recorded a lipsync_mp4 path that did not exist.
MUSETALK_REPO=third_party/MuseTalk
MUSETALK_PYTHON=/data1/dipak_data/miniconda3/envs/musetalk/bin/python
# v15 (default) or v1; selects the checkpoint set the adapter asks for.
MUSETALK_VERSION=v15
MUSETALK_CHECKPOINT=
LATENTSYNC_REPO=third_party/LatentSync
LATENTSYNC_PYTHON=/data1/dipak_data/miniconda3/envs/latentsync/bin/python
LATENTSYNC_UNET_CONFIG=
LATENTSYNC_UNET_CKPT=

# -------------------------------------------------------------------------
# Operator UI (ui/). All optional — every one of these has a working default,
# and none of them is a secret except the two credentials. They are listed
# here because the defaults encode decisions worth knowing about.
#
# Exposure: the UI binds 127.0.0.1 and expects to be reached over an SSH
# tunnel (`ssh -L 7861:localhost:7861 <host>`). Binding anything else without
# DUBBING_UI_USER/PASS is refused outright by ui/auth.py, because this UI
# runs yt-dlp against operator-supplied URLs and starts GPU jobs.
# -------------------------------------------------------------------------
DUBBING_UI_USER=
DUBBING_UI_PASS=

# Where yt-dlp may be pointed, comma-separated. THIS IS THE SSRF CONTROL:
# yt-dlp is a general-purpose fetcher and will happily try
# http://169.254.169.254/ if asked. Default:
#   youtube.com,www.youtube.com,m.youtube.com,youtu.be
DUBBING_UI_ALLOWED_HOSTS=

# Cap on the LIP-SYNCED portion of a job, in seconds (default 1200 = 20 min).
# A whole-video audio-only dub of a longer source is not capped — lip-sync is,
# because it runs at 3-21x clip length on this host's two 16 GiB cards, so
# 20 minutes of video is between one and seven hours of GPU.
DUBBING_UI_MAX_LIPSYNC_S=

# Jobs allowed to run at once (default 1). MuseTalk alone peaks at 15.3 GiB
# of a 16311 MiB card, so a second concurrent job is an OOM, not throughput.
DUBBING_UI_MAX_CONCURRENT=

# Median face height, as a fraction of frame height, above which the auto
# picker chooses MuseTalk over Wav2Lip (default 0.25). Calibrated on three
# clips from one video — a default with a wide margin, not a classifier.
DUBBING_UI_FACE_THRESHOLD=

# tmux session the detached runner launches into (default: dubsync, the
# repo's long-run convention).
DUBBING_UI_TMUX_SESSION=

# Model choices the presets use, when this install's credentials differ.
# Defaults: whisperx / bodhan / edge. Edge needs no key and is the fallback.
DUBBING_UI_ASR_MODEL=
DUBBING_UI_MT_MODEL=
DUBBING_UI_TTS_MODEL=

# Timeouts and data root, for tests and odd hosts. Defaults: 20 s probe,
# 2 h cut, <repo>/data.
DUBBING_UI_PROBE_TIMEOUT_S=
DUBBING_UI_CUT_TIMEOUT_S=
DUBBING_UI_DATA_DIR=

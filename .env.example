# Copy to .env and fill in. .env is gitignored. chmod 600 .env before use.

# HuggingFace token — required for pyannote community-1 (gated).
# Accept the model card at https://hf.co/pyannote/speaker-diarization-community-1
# before the token can pull the weights.
HF_TOKEN=

# Optional: force a compute device. Leave blank for auto (cuda if available,
# else cpu). Set to "cpu" to force CPU even when a GPU is present.
DUBBING_DEVICE=

# Share a GPU with someone else's process. Off by default: `backend/gpu.py`
# refuses a card that has ANY foreign compute process on it, because
# queueing behind a stranger's job or OOMing beside it both end badly.
#
# Set to 1 when the neighbour is RESIDENT BUT IDLE — the case the pid rule
# cannot see. Measured 2026-10-22: gpu0 held 1117 MiB of 16311 at 0%
# utilisation and a lip-sync run was refused for a process doing nothing.
#
# NOT a free-memory threshold: one was tried and removed, because our own
# process holds a 1.9-4.7 GiB CUDA context after face detection and a
# threshold reads that as a stranger. The foreign pids are logged at WARNING
# whenever this is on, so a shared run is recorded as one.
#
# The risk is yours: if the neighbour grows, one of the two jobs dies, and
# MuseTalk answers an OOM by exiting 0 having written nothing.
DUBBING_GPU_ALLOW_SHARED=

# How idle a card must look before lip-sync will use it. Since 2026-10-22 a
# GPU counts as free on LOAD rather than on being empty: utilisation under
# the first and foreign memory under the second, both percentages, both
# blank = the defaults (10.0 and 10.0). 10% of a 16311 MiB card is ~1631
# MiB, so a resident-but-idle context passes and a working card does not.
#
# The memory figure is FOREIGN memory — per-process rows minus our own pids
# — not `memory.used`. That is the distinction that killed the earlier VRAM
# floor: this process holds 1.9-4.7 GiB of its own context after face
# detection and ASD, and a `memory.used` threshold reads that as a stranger.
# Utilisation is sampled 3x and the MAX taken, because one read of a job
# between batches is 0%.
DUBBING_GPU_BUSY_UTIL_PCT=
DUBBING_GPU_BUSY_MEM_PCT=

# Optional: the speaker-gender classifier, as a HuggingFace repo id. Blank
# uses `alefiury/wav2vec2-large-xlsr-53-gender-recognition-librispeech`.
# The label map is read off the checkpoint's own `config.id2label` (this one
# is {0: female, 1: male}), and a checkpoint whose labels are not male/female
# is refused at load rather than guessed at — the prediction is a HARD FILTER
# on the voice catalog, so an inverted map miscasts every speaker at once.
DUBBING_GENDER_MODEL=

# -------------------------------------------------------------------------
# ASD — TalkNet and Light-ASD. Neither is pip-installable; clone the repo
# and point these at the clone + a checkpoint from the upstream README.
# -------------------------------------------------------------------------
# Vendored upstreams live under models/<stage>/vendor/ since
# 2026-10-23. LEAVE BLANK: the adapter resolves the new path and
# falls back to third_party/ if the move has not been run here.
# A pin that outlives its target fails at stage 6.
TALKNET_REPO=
TALKNET_CHECKPOINT=
# Frames per forward pass at stage 6. Peak VRAM is ~0.77 MiB/frame and the
# crops are 112x112 whatever the source resolution, so this alone bounds it.
# Blank = 150 (6 s at 25 fps, upstream's longest piece), ~115 MiB. Set 0 to
# score each track in ONE pass -- the pre-2026-10-25 behaviour, which OOMed
# a 7-minute single-face track at 7.91 GiB.
TALKNET_WINDOW_FRAMES=

# Light-ASD (`--asd light_asd`), added 2026-10-25. Cloned straight to
# models/asd/vendor/lightasd -- it has never lived in third_party/.
#   git clone https://github.com/Junhua-Liao/Light-ASD.git \
#       models/asd/vendor/lightasd
# LEAVE BLANK, same stale-pin rule as TALKNET_REPO above.
LIGHTASD_REPO=
# Upstream ships BOTH checkpoints inside the clone's weight/ directory, so
# there is no download owed. Blank = weight/finetuning_TalkSet.model, which
# is deliberately NOT upstream's AVA default: AVA is built from movies that
# include dubbed footage, and an AVA-trained detector marks ~43% of frames
# in dubbed video as speaking when the right answer is zero -- the exact
# condition this pipeline manufactures. The TalkSet weights also score 95.5
# avg F1 on Columbia against the AVA weights' 81.1. A relative path here is
# resolved inside the clone, so `weight/pretrain_AVA.model` switches it.
LIGHTASD_CHECKPOINT=
# Same meaning and same blank-is-the-default rule as TALKNET_WINDOW_FRAMES.
LIGHTASD_WINDOW_FRAMES=

# LR-ASD (`--asd lr_asd`), added 2026-10-25. The same authors' extended
# Light-ASD (IJCV 2025) and the one to PREFER of the two: 0.84M params /
# 0.51G FLOPs against 1.0M / 0.6G, 94.45% AVA val mAP against 94.06%, and
# 86.1% avg Columbia F1 on the AVA weights against 81.1%. Identical
# upstream API, so one adapter class serves both.
#   git clone https://github.com/Junhua-Liao/LR-ASD.git \
#       models/asd/vendor/lrasd
# Same blank-is-better rule as every other repo pin here.
LRASD_REPO=
# Blank = weight/finetuning_TalkSet.model inside the clone, same TalkSet-
# over-AVA reasoning as LIGHTASD_CHECKPOINT above.
LRASD_CHECKPOINT=
LRASD_WINDOW_FRAMES=

# LoCoNet (`--asd loconet`), added 2026-10-26. The first JOINT multi-speaker
# model here: it scores up to NUM_SPEAKERS faces at once, so it is the only
# one that can tell competing faces apart rather than scoring each alone.
# VGGish audio (not MFCC) and a config-driven encoder, so it is a standalone
# adapter, not a subclass. AVA-only weights -> expect false positives on
# dubbed footage; read it as a relative ranker, not an absolute gate.
#   git clone https://github.com/SJTUwxz/LoCoNet_ASD.git \
#       models/asd/vendor/loconet
# Then fetch the Superxixixi/LoCoNet_ASD weights (pytorch_model.bin) into the
# clone as loconet_ava.model via scripts/fetch_assets.py.
# Same blank-is-better rule as every other repo pin here.
LOCONET_REPO= 
# Blank = loconet_ava.model inside the clone.
LOCONET_CHECKPOINT=
LOCONET_WINDOW_FRAMES=
# Joint scoring is ~NUM_SPEAKERS x heavier per window; blank = 3 (multi.yaml).
LOCONET_NUM_SPEAKERS=

# -------------------------------------------------------------------------
# Bodhan AI — ASR / MT / TTS. One endpoint + key per service, per plan §5.
# -------------------------------------------------------------------------
BODHAN_ASR_URL=https://api.bodhan.ai/v1
BODHAN_ASR_KEY=
BODHAN_ASR_MODEL=indic-transcribe-core

BODHAN_MT_URL=https://api.bodhan.ai/v1
BODHAN_MT_KEY=
BODHAN_MT_MODEL=indic-translate

BODHAN_TTS_URL=https://api.bodhan.ai/v1
BODHAN_TTS_KEY=
BODHAN_TTS_MODEL=indic-speak
# Where the speaking rate goes in the /v1/audio/speech payload, and the
# bounds it is clamped to. The published API docs do not list a rate field;
# `speed` follows the OpenAI audio shape this endpoint otherwise matches.
# A 422 on a rated request means this name is wrong — try `rate`, or
# `instructions.speed` to nest it inside the instructions blob. Only sent
# when a rate other than 1.0 is asked for, so leaving these alone keeps the
# payload exactly as it was.
BODHAN_TTS_RATE_FIELD=speed
BODHAN_TTS_RATE_RANGE=0.25,4.0

BODHAN_TRANSLIT_URL=https://api.bodhan.ai/v1
BODHAN_TRANSLIT_KEY=
BODHAN_TRANSLIT_MODEL=indic-transliterate

# -------------------------------------------------------------------------
# OpenRouter — OpenAI-compatible gateway to many hosted LLMs. Read by
# `backend/llm.py`, which `backend/edit_agent.py` uses to turn a plain-English
# edit request into pipeline operations and to rewrite translated lines
# (retranslate / set_tone / code_mix mode=llm). Still unused by the plan's
# "LLM with termbase" code-mix path and by LLM-judge evaluation.
#
# The key is named OPENROUTER_API_KEY rather than ..._KEY (the Bodhan
# pattern) because that is the name OpenRouter's own docs and every
# OpenAI-SDK snippet use — worth the small inconsistency.
#
# OPENROUTER_MODEL takes a full `vendor/model` slug; browse them at
# https://openrouter.ai/models. Keys are issued at
# https://openrouter.ai/keys and are prefixed `sk-or-v1-`.
#
# Leaving it blank gives `google/gemma-3-12b-it` (changed 2026-10-19 from
# the 4B). There is no "gemma-3b" slug on OpenRouter; the family is
# google/gemma-3-{1b,4b,12b,27b}-it, each also available as `:free`.
# A 4B model is a weak structured-output generator, which is why the edit
# agent validates every op it returns and falls back to a regex parser —
# move to 12b/27b if the readings come back wrong too often.
#
# Leaving the whole block blank breaks nothing: the edit agent runs on its
# regex parser, and only the text-rewriting ops refuse.
# -------------------------------------------------------------------------
OPENROUTER_API_KEY=

# -------------------------------------------------------------------------
# Langfuse — LLM tracing, token usage, cost and latency. Added 2026-10-19.
#
# OPTIONAL: leave blank and tracing is a no-op, exactly as a blank
# OPENROUTER_API_KEY is. Nothing warns on the hot path when both are unset.
#
# BOTH KEYS ARE REQUIRED. Langfuse authenticates with HTTP Basic where the
# PUBLIC key is the username and the SECRET key is the password — for the
# SDK and the REST API alike. A secret key on its own can neither send
# traces nor read usage back.
#
# The public key is NOT a secret. Langfuse → Project Settings → API Keys
# shows the pk-lf-… any time you look; only the sk-lf-… is displayed once
# and unrecoverable. So "I only have the private key" is fixed by copying
# the public one out of that page.
#
# `$PY -m backend.edit_agent --check-langfuse` verifies the pair and the
# host in one round trip and prints no secrets.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Blank = https://cloud.langfuse.com. Point it at your own instance to keep
# the traced text on this host: LANGFUSE_HOST=http://localhost:3000
LANGFUSE_HOST=

# 0 sends timings, token counts, costs and model parameters but NOT prompt
# or completion text. The prompts carry the cue table — the dub's actual
# dialogue — so this is the switch to use when the material is not yours to
# send to a hosted service. Default (blank/1) captures everything.
DUBBING_LANGFUSE_CAPTURE_CONTENT=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# JSON mode: auto (default, = OFF) | on | off.
#
# OFF is a measurement, not a preference. On 2026-10-19 gemma-3-12b-it with
# `response_format={"type":"json_object"}` answered the edit-agent prompt with
#     {"ops":[{}]}
#     {".ops":[{".op":".lipsync_window", ...
# — an empty op, and keys prefixed with a full stop. Both are VALID JSON, so
# nothing downstream can tell they are wrong. The same requests with json mode
# off came back correct in ```json fences, which `extract_json` already strips.
# Set `on` only for a model that genuinely needs the constraint.
OPENROUTER_JSON_MODE=

# Optional transport knobs for backend/llm.py. Defaults in brackets.
OPENROUTER_MAX_RETRIES=          # [4] retries on 429/5xx, exponential backoff
OPENROUTER_MIN_INTERVAL_S=       # [0] floor between requests, as Bodhan uses

# Stage 9c2, backend/condense.py — shortening a line the tempo stretch
# cannot fit. The model slug and the segments per request.
CONDENSE_MODEL=                  # [google/gemini-3.1-flash-lite] see condense.py

# [2] Segments per request. The ~2.9k-token system prompt is sent once per
# REQUEST, so batching is what stops N over-long lines paying for it N
# times. Kept small on purpose: the failure that matters is not a dropped
# segment (the id mapping catches that) or a too-long rewrite (the duration
# re-score catches that) but a line that borrowed its neighbour's wording —
# short, fluent, and in the wrong place. 1 sends every segment alone.
CONDENSE_BATCH_SIZE=

# -------------------------------------------------------------------------
# Voice conversion. Both OpenVoice v2 and Vevo are run from a local
# clone; neither ships on PyPI. Vevo weights are CC-BY-NC — do not use
# in deployed builds without re-checking the licence.
# -------------------------------------------------------------------------

# -------------------------------------------------------------------------
# Lip-sync. Four adapters; each wraps an external repo. Weights for the
# Rudrabha-group models (LipGAN, Wav2Lip) are non-commercial-use only.
# LipGAN runs through a PyTorch port (inference_torch.py) that loads the
# original Keras .h5 directly — no TF 1.x env required. Blackwell-safe.
# -------------------------------------------------------------------------
# Vendored upstreams moved to models/lipsync/vendor/<name>/ on
# 2026-10-23 so nothing under models/ reaches outside it. LEAVE BLANK:
# the adapter resolves the new path, then falls back to the old
# third_party/ one if the move has not been run on this checkout.
# Setting it PINS one location and defeats that fallback.
WAV2LIP_REPO=
# LEAVE BLANK, same as WAV2LIP_REPO above: the adapter derives the
# checkpoint from the resolved repo path (models/lipsync/wav2lip_adapter.py).
# A non-blank value here is taken as-is with no existence check, so the old
# `third_party/Wav2Lip/checkpoints/...` path this used to carry stayed
# pinned after the 2026-10-23 vendor move and broke wav2lip at stage 9h.
WAV2LIP_CHECKPOINT=
WAV2LIP_PYTHON=

# Face restoration (`--restore gfpgan`, the UI's "Enhance" panel): a
# Real-ESRGAN x4plus + GFPGAN sharpening pass run over a finished lip-sync
# render. Its own env exists because basicsr imports
# torchvision.transforms.functional_tensor (gone in torchvision >= 0.17) while
# `dubbing` is on 0.23, and these sm_120 cards rule out pinning torch back.
# `models/restore/gfpgan_adapter.py` reads these two names (not WAV2LIPHD_*,
# which nothing reads since the standalone wav2lip_hd adapter was retired
# 2026-10-23). Blank RESTORE_PYTHON is safe: resolve_env_python() falls back
# to the sibling conda env.
RESTORE_PYTHON=
RESTORE_WEIGHTS=models/weights/wav2lip_hd

# MuseTalk and LatentSync each need their OWN interpreter, and leaving the
# PYTHON var blank is NOT the harmless default it is for LipGAN/Wav2Lip.
# Those two run in the `dubbing` env; these two cannot -- their upstream pins
# are incompatible, which is why the separate conda envs exist at all.
# `<MODEL>_PYTHON` empty falls back to `sys.executable`, i.e. the `dubbing`
# env, where `import diffusers` fails and the adapter dies AFTER the pipeline
# has paid for ASR, MT, TTS and the mix. Measured 2026-10-17: a 40 s clip ran
# all 15 stages, logged `lipsync[musetalk]: done ->` with `err=... rc=1` in a
# parenthetical, exited 0, and recorded a lipsync_mp4 path that did not exist.
# Vendored upstreams moved to models/lipsync/vendor/<name>/ on
# 2026-10-23 so nothing under models/ reaches outside it. LEAVE BLANK:
# the adapter resolves the new path, then falls back to the old
# third_party/ one if the move has not been run on this checkout.
# Setting it PINS one location and defeats that fallback.
MUSETALK_REPO=
# LEAVE BLANK: resolve_env_python() finds the sibling `musetalk` conda env
# next to whichever interpreter is actually running, derived the same way
# media_io._ffmpeg_bin() finds the running env's ffmpeg. A host-absolute pin
# here is taken as-is with no existence check and defeats that lookup on any
# machine where the conda prefix differs.
MUSETALK_PYTHON=
# v15 (default) or v1; selects the checkpoint set the adapter asks for.
MUSETALK_VERSION=v15
MUSETALK_CHECKPOINT=
# Vendored upstreams moved to models/lipsync/vendor/<name>/ on
# 2026-10-23 so nothing under models/ reaches outside it. LEAVE BLANK:
# the adapter resolves the new path, then falls back to the old
# third_party/ one if the move has not been run on this checkout.
# Setting it PINS one location and defeats that fallback.
LATENTSYNC_REPO=
# LEAVE BLANK — same sibling-env lookup and same reason as MUSETALK_PYTHON
# above.
LATENTSYNC_PYTHON=
# 1.5 | 1.6 (default 1.6). The registry also offers `latentsync15` as its
# own model id, which is how the UI picker reaches 1.5.
#
# A version is a (checkpoint, resolution) PAIR -- upstream's 1.6 changelog
# says both must change together. The adapter reads `data.resolution` out of
# the config and REFUSES a mismatch, because the two versions share an
# architecture: a 1.5 checkpoint loads fine under a 512 config and simply
# generates a soft mouth, with no error, after ~80x the clip length.
#
#   1.6 -> configs/unet/stage2_512.yaml + checkpoints/latentsync_unet.pt
#   1.5 -> configs/unet/stage2.yaml     + checkpoints/latentsync_unet_1.5.pt
#
# 1.5's weights are a separate download (ByteDance/LatentSync-1.5) and
# upstream ships BOTH versions as `latentsync_unet.pt`, so 1.5 is given a
# distinct filename here -- dropping it on top of the 1.6 file would turn
# every 1.6 run into a silent mismatch.
LATENTSYNC_VERSION=
# Override the version's config/checkpoint. Leave blank to use the pair above.
LATENTSYNC_UNET_CONFIG=
LATENTSYNC_UNET_CKPT=

# -------------------------------------------------------------------------
# Operator UI (ui/). All optional — every one of these has a working default.
# They are listed here because the defaults encode decisions worth knowing
# about.
#
# Exposure: the UI binds 127.0.0.1 and expects to be reached over an SSH
# tunnel (`ssh -L 7861:localhost:7861 <host>`). There is NO authentication —
# HTTP basic auth and the public-bind guard were removed 2026-10-25. Every
# route is open to anyone who can reach the port, and this UI runs yt-dlp
# against operator-supplied URLs and starts GPU jobs, so the loopback bind
# and the host allowlist below are now the ONLY controls. Do not bind a
# public address.
# -------------------------------------------------------------------------

# LEAVE BLANK on a conda install: scripts/start_ui.sh resolves the dubbing
# env's interpreter itself (sibling-env lookup, same trick as
# MUSETALK_PYTHON above) and exports this for the server process, which in
# turn passes it to every job it launches (scripts/ui_run_job.sh,
# ui/jobqueue.py) so a detached job always uses the exact interpreter that
# is already proven to work, rather than a second independent guess. Only
# set this by hand if start_ui.sh's own resolution picks the wrong one.
DUBBING_PY=

# Where yt-dlp may be pointed, comma-separated. THIS IS THE SSRF CONTROL:
# yt-dlp is a general-purpose fetcher and will happily try
# http://169.254.169.254/ if asked. Default:
#   youtube.com,www.youtube.com,m.youtube.com,youtu.be
DUBBING_UI_ALLOWED_HOSTS=

# Cap on the LIP-SYNCED portion of a job, in seconds (default 1200 = 20 min).
# A whole-video audio-only dub of a longer source is not capped — lip-sync is,
# because it runs at 3-21x clip length on this host's two 16 GiB cards, so
# 20 minutes of video is between one and seven hours of GPU.
DUBBING_UI_MAX_LIPSYNC_S=

# Jobs allowed to run at once (default 1). MuseTalk alone peaks at 15.3 GiB
# of a 16311 MiB card, so a second concurrent job is an OOM, not throughput.
DUBBING_UI_MAX_CONCURRENT=

# Median face height, as a fraction of frame height, above which the auto
# picker chooses MuseTalk over Wav2Lip (default 0.25). Calibrated on three
# clips from one video — a default with a wide margin, not a classifier.
DUBBING_UI_FACE_THRESHOLD=

# tmux session the detached runner launches into (default: dubsync, the
# repo's long-run convention).
DUBBING_UI_TMUX_SESSION=

# Model choices the presets use, when this install's credentials differ.
# Defaults: whisperx / bodhan / edge. Edge needs no key and is the fallback.
DUBBING_UI_ASR_MODEL=
DUBBING_UI_MT_MODEL=
DUBBING_UI_TTS_MODEL=

# Timeouts and data root, for tests and odd hosts. Defaults: 20 s probe,
# 2 h cut, <repo>/data.
DUBBING_UI_PROBE_TIMEOUT_S=
DUBBING_UI_CUT_TIMEOUT_S=
DUBBING_UI_DATA_DIR=

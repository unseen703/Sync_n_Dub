+# PATCHED (dubbingstudio 2026-10-20): check system memory before each batch.
+#
+# This file holds one decoded uint8 frame per source frame for the whole
+# clip (`read_imgs()` above), so resident memory is frames x w x h x 3 --
+# measured 5.87 GiB + 6.14 MiB/frame at 1080p on the host this runs on,
+# which has 62 GiB. The caller segments the clip to bound that, and this is
+# the in-render backstop for pressure the caller cannot see.
+#
+# Self-contained ON PURPOSE: MuseTalk runs in its own conda env with its own
+# sys.path, so `backend.memguard` is not importable here. Both read
+# DUBBING_MEM_GUARD_PCT so the two halves cannot disagree.
+#
+# MemAvailable, not MemFree: this very script writes every frame to disk as
+# PNG and reads it back, leaving ~10 GB of page cache on a 2-minute 1080p
+# segment. Page cache is reclaimable, so MemFree would read a healthy host
+# as full and stall every run.
+# PATCHED (dubbingstudio 2026-10-20): optional lazy frame access.
+#
+# `read_imgs()` loads EVERY frame into a Python list, so resident memory is
+# frames x w x h x 3 -- measured 6.14 MiB/frame at 1080p against a 5.93 MiB
+# theoretical frame, i.e. it is purely the pixels. The frames are already on
+# disk: this script extracted them to PNG a few lines earlier and then reads
+# them straight back, so the list is a redundant in-memory duplicate.
+#
+# `_LazyFrames` is a drop-in sequence that reads each PNG on access instead.
+# It has to support exactly what the two consumers do:
+#   pass A  `for bbox, frame in zip(coord_list, frame_list)`      -> __iter__
+#   cycle   `frame_list + frame_list[::-1]`                        -> slice, __add__
+#   pass B  `frame_list_cycle[i % len(frame_list_cycle)]`          -> __getitem__, __len__
+#
+# The cost is one EXTRA decode per frame: today read_imgs decodes N times and
+# both passes read RAM for free; lazily, each pass decodes N. Measured warm
+# PNG decode on this host is 26.44 ms/frame, so ~+N x 26 ms.
+#
+# Off by default. `MUSETALK_LAZY_FRAMES=1` turns it on.
+_LAZY_FRAMES = os.environ.get("MUSETALK_LAZY_FRAMES", "0") == "1"
+
+
+class _LazyFrames:
+    """A list-like view over image paths that decodes on access."""
+
+    __slots__ = ("_paths",)
+
+    def __init__(self, paths):
+        self._paths = list(paths)
+
+    def __len__(self):
+        return len(self._paths)
+
+    def __getitem__(self, idx):
+        if isinstance(idx, slice):
+            return _LazyFrames(self._paths[idx])
+        return cv2.imread(self._paths[idx])
+
+    def __iter__(self):
+        for p in self._paths:
+            yield cv2.imread(p)
+
+    def __add__(self, other):
+        other_paths = getattr(other, "_paths", None)
+        if other_paths is None:
+            return NotImplemented
+        return _LazyFrames(self._paths + other_paths)
+
+
+_MEM_LIMIT_PCT = float(os.environ.get("DUBBING_MEM_GUARD_PCT", "95") or 95)
+_MEM_WAIT_S = float(os.environ.get("DUBBING_MEM_WAIT_S", "180") or 180)
+_MEM_POLL_S = 5.0
+
+
+def _system_mem_used_pct():
+    """Share of system RAM in use, or None if it cannot be read."""
+    try:
+        total = avail = None
+        with open("/proc/meminfo") as fh:
+            for line in fh:
+                key, _, rest = line.partition(":")
+                if key == "MemTotal":
+                    total = float(rest.split()[0])
+                elif key == "MemAvailable":
+                    avail = float(rest.split()[0])
+                if total is not None and avail is not None:
+                    break
+        if not total:
+            return None
+        return 100.0 * (total - avail) / total
+    except Exception:
+        return None
+
+
+def _wait_for_memory(where):
+    """Pause before `where` while system RAM is past the limit.
+
+    Pausing only helps when something ELSE is holding the memory -- another
+    tenant, or page cache the kernel can drop. When THIS render is the
+    consumer, waiting cannot free anything, so the wait is bounded and then
+    raises instead of hanging a GPU job forever. The exception surfaces
+    through the adapter's stderr tail with the numbers in it.
+    """
+    if _MEM_LIMIT_PCT <= 0:
+        return
+    pct = _system_mem_used_pct()
+    if pct is None or pct < _MEM_LIMIT_PCT:
+        return
+    print("[memguard] %s: system RAM %.1f%% >= %.0f%% -- pausing up to %.0fs"
+          % (where, pct, _MEM_LIMIT_PCT, _MEM_WAIT_S), flush=True)
+    waited = 0.0
+    while waited < _MEM_WAIT_S:
+        time.sleep(_MEM_POLL_S)
+        waited += _MEM_POLL_S
+        pct = _system_mem_used_pct()
+        if pct is None or pct < _MEM_LIMIT_PCT:
+            print("[memguard] %s: resumed after %.0fs at %.1f%%"
+                  % (where, waited, pct if pct is not None else -1),
+                  flush=True)
+            return

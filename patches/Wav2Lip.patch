 def face_detect(images):
+	# PATCHED (dubbingstudio 2026-10-19): per-frame box cache.
+	# Upstream recomputes S3FD over every frame on every run. Re-rendering the
+	# same clip -- which is what changing a voice, a tone or a batch size
+	# actually does -- pays for the whole detection pass again. MuseTalk has
+	# `--use_saved_coord`/`--saved_coord` for this; Wav2Lip had nothing, so
+	# the same two flag names are added here to keep the adapters symmetric.
+	#
+	# Only the SMOOTHED boxes and the face mask are cached (N x 4 ints, a few
+	# KB). The crops are not: they are a slice of `images`, so caching them
+	# would store the whole video a second time.
+	#
+	# A hit skips constructing the detector at all, so it saves the S3FD
+	# weights' VRAM as well as the detection time.
+	global _face_present_mask
+	if getattr(args, 'use_saved_coord', False) and args.coord_path \
+			and os.path.isfile(args.coord_path):
+		with open(args.coord_path, 'rb') as f:
+			blob = pickle.load(f)
+		boxes, mask = blob.get('boxes'), blob.get('mask')
+		if boxes is not None and len(boxes) == len(images):
+			print('Using saved face coordinates ({} frames)'.format(len(boxes)))
+			_face_present_mask = mask if mask is not None else [True] * len(images)
+			return [[image[y1: y2, x1:x2], (y1, y2, x1, x2)]
+					for image, (x1, y1, x2, y2) in zip(images, boxes)]
+		# A length mismatch means these boxes belong to a different clip.
+		# Recompute rather than draw one video's mouths onto another's frames.
+		print('Saved coordinates do not match this clip ({} vs {} frames); '
+			  'recomputing'.format(len(boxes) if boxes is not None else None,
+								   len(images)))
+
